YOUTUBE_API_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=radar_viral
DB_USER=radar
DB_PASSWORD=change-me
SEARCH_TERMS=curiosidades;historias de terror;inteligencia artificial;datos interesantes;gaming;recetas;fitness
MAX_SEARCHES_PER_RUN=7
MAX_RESULTS_PER_SEARCH=25
MAX_VIDEO_AGE_DAYS=60

# Automatic updates: existing metrics every 15 min, discovery every 6 h.
REFRESH_INTERVAL_SECONDS=900
DISCOVERY_INTERVAL_SECONDS=21600
REFRESH_MAX_VIDEOS=500

# Solo para el dashboard Flask (no funciona en Render Static)
# Genera estos tres valores con: python src/create_admin.py --username neutrinitoo --generate-password
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
SESSION_SECRET=
# En local con HTTP dejar 0; en producción HTTPS usar 1.
AUTH_COOKIE_SECURE=0
