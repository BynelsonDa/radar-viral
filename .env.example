# Crea una clave en Google Cloud con YouTube Data API v3 habilitada.
YOUTUBE_API_KEY=
# Contraseñas locales: reemplázalas antes de levantar Docker.
DB_HOST=db
DB_PORT=3306
DB_NAME=radar_viral
DB_USER=radar
DB_PASSWORD=change-me-db
MYSQL_ROOT_PASSWORD=change-me-root
SEARCH_TERMS=curiosidades;historias de terror;inteligencia artificial;datos interesantes;gaming;recetas;fitness
MAX_SEARCHES_PER_RUN=7
MAX_RESULTS_PER_SEARCH=25
MAX_VIDEO_AGE_DAYS=60
